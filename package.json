{
  "name": "mp3-frame-counter",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP API that counts MPEG-1 Audio Layer III frames in an uploaded MP3.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "form-data": "^4.0.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "clearMocks": true
  }
}
